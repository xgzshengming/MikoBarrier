<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>MikoBarrier.Guard</AssemblyName>
    <RootNamespace>MikoBarrier.Guard</RootNamespace>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- 看门狗进程没有界面，但 exe 也复用 App 项目里的同一份应用图标。 -->
    <ApplicationIcon>..\MikoBarrier.App\Assets\MikoBarrier.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MikoBarrier.Core\MikoBarrier.Core.csproj" />
  </ItemGroup>

</Project>
