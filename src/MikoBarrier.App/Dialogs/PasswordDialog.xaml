<Window x:Class="MikoBarrier.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="请输入密码" Width="470" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <controls:WindowTitleBar x:Name="TitleBarControl" Title="请输入密码" IsDialogMode="True" />

            <StackPanel Margin="24,2,24,22">
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Text="请输入密码：" />
                <controls:PasswordRevealBox x:Name="InputBox" Margin="0,12,0,0" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="忘记密码？" Click="Forgot_Click" />
                    <Button Content="取消" Click="Cancel_Click" />
                    <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Margin="0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>