<Window x:Class="MikoBarrier.Dialogs.TaskPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择本轮任务" Height="480" Width="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <DockPanel>
            <controls:WindowTitleBar x:Name="TitleBarControl" DockPanel.Dock="Top"
                                     Title="选择本轮关联的任务" IsDialogMode="True" />

            <StackPanel DockPanel.Dock="Bottom" Margin="20,12,20,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SelectAllButton" Content="全选" Click="SelectAll_Click" />
                    <Button x:Name="ClearButton" Content="清空本轮选择" Click="Clear_Click" />
                    <Button Content="取消" Click="Cancel_Click" />
                    <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Margin="0" />
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="TaskList" Margin="20,14,20,0" SelectionMode="Extended" />
        </DockPanel>
    </Border>
</Window>
