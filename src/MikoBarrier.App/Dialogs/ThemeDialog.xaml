<Window x:Class="MikoBarrier.Dialogs.ThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="自定义主题" Width="840" Height="660"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <DockPanel LastChildFill="True">
            <controls:WindowTitleBar x:Name="TitleBarControl" DockPanel.Dock="Top" Title="自定义主题" IsDialogMode="True" />

            <DockPanel DockPanel.Dock="Bottom" Margin="24,12,24,20">
                <Button DockPanel.Dock="Left" x:Name="ResetButton" Content="恢复默认外观" Click="Reset_Click" />
                <Button DockPanel.Dock="Right" x:Name="DoneButton" Content="完成"
                        Style="{StaticResource PrimaryButton}" Click="Done_Click" Margin="0" />
            </DockPanel>

            <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          FocusVisualStyle="{x:Null}" Margin="24,2,24,0">
                <StackPanel>
                    <TextBlock Text="预设主题" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="点击卡片立即应用到整个软件。可以在此基础上再单独选择界面字体或窗口背景色。" />

                    <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0"
                             Padding="0" SelectionChanged="PresetList_SelectionChanged"
                             PreviewMouseWheel="PresetList_PreviewMouseWheel"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SelBorder" Margin="3" Padding="2"
                                                    CornerRadius="13" BorderThickness="2"
                                                    BorderBrush="Transparent" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SelBorder" Property="Background"
                                                            Value="{DynamicResource Brush.Control}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelBorder" Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Accent}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="单独设置" FontWeight="SemiBold" FontSize="15" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="330" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="界面字体" VerticalAlignment="Center" />
                                <ComboBox x:Name="FontBox" Grid.Column="1" HorizontalAlignment="Left" Width="320"
                                          MaxDropDownHeight="260" SelectionChanged="FontBox_SelectionChanged"
                                          PreviewMouseWheel="FontBox_PreviewMouseWheel" />
                                <TextBlock x:Name="FontPreviewText" Grid.Column="2" Text="字体预览：中文 Aa 123"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="窗口背景色" VerticalAlignment="Center" />
                                <Border x:Name="BackgroundSwatch" Grid.Column="1" Height="30" CornerRadius="8"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                <TextBox x:Name="BackgroundHexBox" Grid.Column="2" Margin="8,0,0,0"
                                         CharacterCasing="Upper" ToolTip="输入 6 位十六进制色值后按回车"
                                         LostKeyboardFocus="BackgroundHexBox_LostKeyboardFocus"
                                         KeyDown="BackgroundHexBox_KeyDown" />
                                <Button Grid.Column="3" Content="选颜色&#x2026;" Click="PickColor_Click" />
                                <Button x:Name="ClearBackgroundButton" Grid.Column="4" Content="跟随预设"
                                        HorizontalAlignment="Left" Click="ClearBackground_Click" />
                            </Grid>

                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="面板、输入框和边框会按背景色自动推导，正文会自动选择深 / 浅色；强调色、警告色跟随所选预设。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
