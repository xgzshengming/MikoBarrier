<Window x:Class="MikoBarrier.Dialogs.GuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="使用引导" Width="640" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <DockPanel LastChildFill="True">
            <controls:WindowTitleBar x:Name="TitleBarControl" DockPanel.Dock="Top"
                                     Title="使用引导" IsDialogMode="True" />

            <!-- 固定底部：正文过长时只滚动正文，按钮永远可见。 -->
            <Grid DockPanel.Dock="Bottom" Margin="24,16,24,22">
                <TextBlock x:Name="PageIndicatorText" Style="{StaticResource Muted}"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Content="跳过" Click="Skip_Click" />
                    <Button x:Name="PrevButton" Content="上一步" Click="Prev_Click" />
                    <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}"
                            Click="Next_Click" Margin="0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Margin="24,2,24,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PageBodyText" TextWrapping="Wrap" LineHeight="22"
                               Margin="0,12,0,8" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
