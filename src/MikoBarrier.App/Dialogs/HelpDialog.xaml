<Window x:Class="MikoBarrier.Dialogs.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="使用帮助" Width="700" Height="620" MinWidth="520" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <DockPanel LastChildFill="True">
            <controls:WindowTitleBar x:Name="TitleBarControl" DockPanel.Dock="Top"
                                     Title="使用帮助" IsDialogMode="True" />

            <!-- 固定底部按钮：正文可滚动，帮助入口永远可见。 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="24,16,24,22">
                <Button x:Name="BackToHomeButton" Content="返回选择" Click="BackToHome_Click"
                        Visibility="Collapsed" />
                <Button x:Name="ReplayButton" Content="重新演示当前页使用方式"
                        Style="{StaticResource PrimaryButton}" Click="Replay_Click" />
                <Button x:Name="CloseButton" Content="关闭" Click="Close_Click" Margin="0" />
            </StackPanel>

            <Grid Margin="24,2,24,0">
                <StackPanel x:Name="HomePanel" VerticalAlignment="Top">
                    <TextBlock Text="使用帮助" Style="{StaticResource H1}" />
                    <TextBlock x:Name="TopicText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <TextBlock Text="你可以重新演示当前页面的分步引导，或者查看全部功能的文字版说明。"
                               TextWrapping="Wrap" Margin="0,16,0,0" />
                    <Button x:Name="ShowTextButton" Content="查看文字版使用说明"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Click="ShowText_Click" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"
                               Margin="0,30,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="TextPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TextHelpBlock" TextWrapping="Wrap" LineHeight="22" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
