<Window x:Class="MikoBarrier.Dialogs.RecoveryCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="使用恢复码" Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <controls:WindowTitleBar x:Name="TitleBarControl" Title="使用恢复码" IsDialogMode="True" />

            <StackPanel Margin="24,2,24,22">
                <TextBlock Text="恢复码可用于提前结束自律（每天 1 次），也可在忘记密码时重设密码（不限次数）。"
                           TextWrapping="Wrap" Style="{StaticResource Muted}" />
                <TextBlock x:Name="PromptText" Text="请输入恢复码：" TextWrapping="Wrap" Margin="0,12,0,6" />
                <TextBox x:Name="CodeBox" CharacterCasing="Upper" FontFamily="Consolas" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RevealSavedButton" Content="查看本机保存的恢复码" Click="RevealSaved_Click" />
                </StackPanel>

                <TextBox x:Name="SavedCodeText" IsReadOnly="True" FontFamily="Consolas" FontWeight="SemiBold"
                         Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="取消" Click="Cancel_Click" />
                    <Button Content="确定" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Margin="0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
