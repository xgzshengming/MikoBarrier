<Window x:Class="MikoBarrier.Dialogs.WhitelistPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="一键白名单" Width="540" Height="600"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <DockPanel LastChildFill="True">
            <controls:WindowTitleBar x:Name="TitleBarControl" DockPanel.Dock="Top"
                                     Title="一键白名单" IsDialogMode="True" />

            <!-- 固定底部：无论列表多长，取消 / 继续都永远可见 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,20">
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="点「继续」后会要求输入密码；点「取消」不会修改任何配置。" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" Click="Cancel_Click" />
                    <Button x:Name="OkButton" Content="继续" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Margin="0" />
                </StackPanel>
            </StackPanel>

            <!-- 固定顶部：只显示摘要，不再贴长路径 -->
            <StackPanel DockPanel.Dock="Top" Margin="20,4,20,0">
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubSummaryText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="TogglePathsButton" Content="展开路径" Click="TogglePaths_Click" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextWrapping="Wrap"
                               Text="列表可滚动；也可以点每行右侧的「路径」单独展开。" />
                </StackPanel>
            </StackPanel>

            <!-- 可滚动列表：默认只显示名称，路径按需展开 -->
            <ListBox x:Name="ItemList" Margin="20,10,20,0"
                     Focusable="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Content="路径"
                                    Click="ItemPath_Click"
                                    FontSize="11" Padding="8,2" Margin="8,0,0,0" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding FilePath}"
                                       Visibility="{Binding PathVisibility}"
                                       Style="{StaticResource Muted}"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,1" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
