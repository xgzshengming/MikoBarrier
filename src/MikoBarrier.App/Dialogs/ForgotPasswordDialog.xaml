<Window x:Class="MikoBarrier.Dialogs.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MikoBarrier.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="忘记密码 &#xB7; 用安全问题重设" Height="640" Width="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <DockPanel>
            <controls:WindowTitleBar x:Name="TitleBarControl" DockPanel.Dock="Top" Title="忘记密码 &#xB7; 用安全问题重设" IsDialogMode="True" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,22">
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="用恢复码重设" Click="ResetWithRecovery_Click" />
                <Button Content="用安全问题重设" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Margin="0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,2,24,0">
                <StackPanel>
                    <TextBlock Text="方式一：用恢复码重设密码（不限次数，但不会解除密码退出冷却 / 冻结）。"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="如果本机保存过恢复码，点「填入本机恢复码」；也可以手动输入。"
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="RecoveryCodeBox" Width="270" FontFamily="Consolas" CharacterCasing="Upper" />
                        <Button Content="填入本机恢复码" Click="FillSavedRecovery_Click" />
                    </StackPanel>

                    <TextBlock Text="方式二：答对全部 3 个安全问题后重设密码（答案不区分大小写、忽略空格）。"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0" />

                    <TextBlock x:Name="Question1Text" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,4" />
                    <TextBox x:Name="Answer1Box" />

                    <TextBlock x:Name="Question2Text" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,4" />
                    <TextBox x:Name="Answer2Box" />

                    <TextBlock x:Name="Question3Text" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,14,0,4" />
                    <TextBox x:Name="Answer3Box" />

                    <TextBlock Text="设置新密码（至少 16 位，含大小写字母、数字、特殊字符）" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,20,0,6" />
                    <controls:PasswordRevealBox x:Name="NewPasswordBox" />
                    <TextBlock Text="确认新密码" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                    <controls:PasswordRevealBox x:Name="ConfirmPasswordBox" />

                    <TextBlock x:Name="HintText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,12" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>