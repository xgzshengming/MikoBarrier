<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      启动时的初始刷子（浅色默认预设 light-navy）。
      运行时由 ThemeManager 动态生成同 key 的资源并整体替换，用户切换主题后这里不再生效。
    -->
    <FontFamily x:Key="Font.UI">DengXian</FontFamily>
    <SolidColorBrush x:Key="Brush.Window" Color="#F2F5F9" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control" Color="#E9EEF6" />
    <SolidColorBrush x:Key="Brush.Text" Color="#15202E" />
    <SolidColorBrush x:Key="Brush.SubText" Color="#5A6B80" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D3DDEA" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#1F3A5F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C0392B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#1E7F4F" />

</ResourceDictionary>
