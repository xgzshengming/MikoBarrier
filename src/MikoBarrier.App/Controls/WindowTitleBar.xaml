<UserControl x:Class="MikoBarrier.Controls.WindowTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="40">

    <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Title, ElementName=Root}"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Margin="16,0,0,0"
                   Foreground="{DynamicResource Brush.SubText}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="HelpButton" Style="{StaticResource CaptionButton}" Click="Help_Click"
                    ToolTip="帮助">
                <Border Width="16" Height="16" CornerRadius="8"
                        BorderBrush="{DynamicResource Brush.SubText}" BorderThickness="1">
                    <TextBlock Text="?" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Button>
            <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" />
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="Close_Click" />
        </StackPanel>
    </Grid>
</UserControl>
