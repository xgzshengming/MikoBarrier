<UserControl x:Class="MikoBarrier.Controls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <PasswordBox x:Name="HiddenBox" Grid.Column="0" PasswordChar="&#x25CF;"
                     PasswordChanged="HiddenBox_PasswordChanged" />
        <TextBox x:Name="VisibleBox" Grid.Column="0" Visibility="Collapsed"
                 TextChanged="VisibleBox_TextChanged" />
        <ToggleButton x:Name="RevealButton" Grid.Column="1"
                      Style="{StaticResource RevealEyeButton}"
                      Click="RevealButton_Click" />
    </Grid>
</UserControl>
