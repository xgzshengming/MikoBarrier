<UserControl x:Class="MikoBarrier.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MikoBarrier.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
        <StackPanel Margin="28">
            <!-- 系统设置主页 -->
            <StackPanel x:Name="SettingsHubPanel">
                <TextBlock Text="系统设置" Style="{StaticResource H1}" />
                <UniformGrid Columns="2" Margin="0,14,0,0">
                    <Button x:Name="HubAppearanceButton" Style="{StaticResource HubButton}" Margin="0,0,7,12" Click="HubAppearance_Click">
                        <StackPanel>
                            <TextBlock Text="外观与启动" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="主题 / 开机自启 / 托盘" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HubSecurityButton" Style="{StaticResource HubButton}" Margin="7,0,0,12" Click="HubSecurity_Click">
                        <StackPanel>
                            <TextBlock Text="密码与防改动" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="密码 / 恢复码 / 安全问题" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Margin="0,2,0,0">
                    <StackPanel>
                        <TextBlock Text="数据与运行环境" FontWeight="SemiBold" />
                        <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="EnvText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="打开数据目录" Click="OpenDataFolder_Click" />
                            <Button Content="打开日志目录" Click="OpenLogFolder_Click" />
                            <Button Content="以管理员身份重启" Click="RelaunchElevated_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="开源与反馈" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="MikoBarrier 以 Apache-2.0 开源、无遥测。去 GitHub 点个 Star，能让更多需要它的人看到。" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="在 GitHub 上 Star" Click="OpenRepo_Click" />
                            <Button Content="反馈问题 / 建议" Click="OpenIssues_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 外观与启动 -->
            <StackPanel x:Name="AppearancePagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回系统设置" HorizontalAlignment="Left" Click="BackToSettingsHub_Click" Margin="0,0,0,10" />
                <TextBlock Text="外观与启动" Style="{StaticResource H1}" />

                  <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                      <StackPanel>
                          <TextBlock Text="界面模式" FontWeight="SemiBold" />
                          <TextBlock x:Name="MikoModeHint" Style="{StaticResource Muted}"
                                     TextWrapping="Wrap" Margin="0,6,0,0" />
                          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                              <RadioButton x:Name="NormalModeRadio" GroupName="UiMode" Content="普通模式"
                                           Checked="UiMode_Checked" />
                              <RadioButton x:Name="MikoModeRadio" GroupName="UiMode" Content="巫女模式"
                                           Margin="18,0,0,0" Checked="UiMode_Checked" />
                          </StackPanel>
                          <Button x:Name="UseMikoThemeButton" Content="使用「真·巫女」主题"
                                  HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed"
                                  Click="UseMikoTheme_Click" />
                      </StackPanel>
                  </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="主题" VerticalAlignment="Center" Width="70" />
                            <TextBlock x:Name="ThemeSummaryText" VerticalAlignment="Center" Margin="0,0,14,0"
                                       TextTrimming="CharacterEllipsis" />
                            <Button x:Name="OpenThemeDialogButton" Content="自定义主题&#x2026;"
                                    Click="OpenThemeDialog_Click" />
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动（计划任务，登录时静默提权，不弹 UAC）"
                                  Margin="0,8,0,0" Click="AutoStartCheck_Click" />
                        <CheckBox x:Name="TrayCheck" Content="最小化到系统托盘（关闭窗口时留在后台继续计时）"
                                  Margin="0,4,0,0" Click="TrayCheck_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 密码与防改动 -->
            <StackPanel x:Name="SecurityPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回系统设置" HorizontalAlignment="Left" Click="BackToSettingsHub_Click" Margin="0,0,0,10" />
                <TextBlock Text="密码与防改动" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SecurityStatusText" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="OpenPasswordPageButton" Content="设置 / 修改密码"
                                    Style="{StaticResource PrimaryButton}" Click="OpenPasswordPage_Click" />
                            <Button x:Name="OpenRecoveryPageButton" Content="生成 / 查看恢复码" Click="OpenRecoveryPage_Click" />
                            <Button x:Name="OpenQuestionsSetupPageButton" Content="设置安全问题" Click="OpenQuestionsSetupPage_Click" />
                            <Button x:Name="OpenForgotPageButton" Content="忘记密码？" Click="OpenForgotPage_Click" />
                        </WrapPanel>
                        <TextBlock Text="自律开始后无法更改密码，请开启自律前确保自己记住密码，以防紧急状况下无法退出。"
                                   Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 设置 / 修改密码 -->
            <StackPanel x:Name="PasswordPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回密码与防改动" HorizontalAlignment="Left" Click="BackToSecurity_Click" Margin="0,0,0,10" />
                <TextBlock Text="设置 / 修改密码" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="要求：至少 16 位，同时包含大写字母、小写字母、数字和特殊字符。" />
                        <TextBlock Text="当前密码（首次设置可留空）" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                        <controls:PasswordRevealBox x:Name="CurrentPasswordBox" />
                        <TextBlock Text="新密码" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <controls:PasswordRevealBox x:Name="NewPasswordBox" />
                        <TextBlock Text="确认新密码" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <controls:PasswordRevealBox x:Name="ConfirmPasswordBox" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="保存新密码" Style="{StaticResource PrimaryButton}" Click="SavePassword_Click" />
                            <Button Content="检查强度" Click="CheckStrength_Click" />
                        </StackPanel>
                        <TextBlock x:Name="PasswordHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 恢复码 -->
            <StackPanel x:Name="RecoveryPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回密码与防改动" HorizontalAlignment="Left" Click="BackToSecurity_Click" Margin="0,0,0,10" />
                <TextBlock Text="恢复码" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="RecoveryStatusText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="GenerateRecoveryButton" Content="生成新恢复码"
                                    Style="{StaticResource PrimaryButton}" Click="GenerateRecovery_Click" />
                            <Button x:Name="ViewRecoveryButton" Content="查看本机恢复码" Click="ViewRecovery_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RecoveryHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <StackPanel x:Name="FirstSetupNavPanel" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                            <Button x:Name="FirstSetupNextButton" Content="下一步：设置安全问题"
                                    Style="{StaticResource PrimaryButton}" Click="FirstSetupNext_Click" />
                            <Button x:Name="SkipFirstSetupButton" Content="跳过，以后再说" Click="SkipFirstSetup_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 安全问题：安全问题设置 -->
            <StackPanel x:Name="QuestionsSetupPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回密码与防改动" HorizontalAlignment="Left" Click="BackToSecurity_Click" Margin="0,0,0,10" />
                <TextBlock Text="安全问题" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="答案不区分大小写、忽略空格；只保存哈希，不会明文存储。重新保存时必须把 3 个问题和 3 个答案都重填一遍。" />
                        <TextBlock Text="当前密码（首次设置可留空）" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                        <controls:PasswordRevealBox x:Name="QuestionsCurrentPasswordBox" />
                        <TextBlock Text="问题 1" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <TextBox x:Name="Question1Box" />
                        <TextBox x:Name="Answer1Box" Margin="0,6,0,0" />
                        <TextBlock Text="问题 2" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <TextBox x:Name="Question2Box" />
                        <TextBox x:Name="Answer2Box" Margin="0,6,0,0" />
                        <TextBlock Text="问题 3" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <TextBox x:Name="Question3Box" />
                        <TextBox x:Name="Answer3Box" Margin="0,6,0,0" />
                        <Button Content="保存问答" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                Click="SaveSecurityQuestions_Click" />
                        <TextBlock x:Name="SecurityHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 忘记密码：选择重置方式 -->
            <StackPanel x:Name="ForgotPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回密码与防改动" HorizontalAlignment="Left" Click="BackToSecurity_Click" Margin="0,0,0,10" />
                <TextBlock Text="忘记密码" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="ForgotStatusText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="GoRecoveryResetButton" Content="用恢复码重置密码"
                                    Style="{StaticResource PrimaryButton}" Click="GoRecoveryReset_Click" />
                            <Button x:Name="GoQuestionResetButton" Content="用安全问题重置密码"
                                    Style="{StaticResource PrimaryButton}" Click="GoQuestionReset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 恢复码重置密码 -->
            <StackPanel x:Name="RecoveryResetPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回忘记密码" HorizontalAlignment="Left" Click="BackToForgot_Click" Margin="0,0,0,10" />
                <TextBlock Text="用恢复码重置密码" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="恢复码" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <TextBox x:Name="ResetCodeBox" FontFamily="Consolas" CharacterCasing="Upper" />
                        <TextBlock Text="新密码" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <controls:PasswordRevealBox x:Name="RecoveryResetNewPasswordBox" />
                        <TextBlock Text="确认新密码" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <controls:PasswordRevealBox x:Name="RecoveryResetConfirmPasswordBox" />
                        <Button Content="重置密码" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                Click="RecoveryReset_Click" />
                        <TextBlock x:Name="RecoveryResetHint" Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 安全问题重置密码 -->
            <StackPanel x:Name="QuestionResetPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回忘记密码" HorizontalAlignment="Left" Click="BackToForgot_Click" Margin="0,0,0,10" />
                <TextBlock Text="用安全问题重置密码" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="QuestionReset1Text" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBox x:Name="QuestionResetAnswer1Box" />
                        <TextBlock x:Name="QuestionReset2Text" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4" />
                        <TextBox x:Name="QuestionResetAnswer2Box" />
                        <TextBlock x:Name="QuestionReset3Text" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4" />
                        <TextBox x:Name="QuestionResetAnswer3Box" />
                        <TextBlock Text="新密码" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                        <controls:PasswordRevealBox x:Name="QuestionResetNewPasswordBox" />
                        <TextBlock Text="确认新密码" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <controls:PasswordRevealBox x:Name="QuestionResetConfirmPasswordBox" />
                        <Button Content="重置密码" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                Click="QuestionReset_Click" />
                        <TextBlock x:Name="QuestionResetHint" Foreground="{DynamicResource Brush.Danger}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>