<UserControl x:Class="MikoBarrier.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
        <StackPanel Margin="28">
            <!-- 统计主页：概览 + 两个子界面入口 -->
            <StackPanel x:Name="StatsHubPanel">
                <TextBlock Text="自律统计" Style="{StaticResource H1}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="今日完成" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="TodayCountText" Text="0 次" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="累计完成" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="TotalCountText" Text="0 次" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="累计专注时长" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="TotalTimeText" Text="0 小时 0 分钟" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="本周汇总（周一起，本地时间）" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="WeekSummaryText" Text="完成 0 次" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="本月汇总（本地时间）" Style="{StaticResource Muted}" />
                            <TextBlock x:Name="MonthSummaryText" Text="完成 0 次" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Columns="2" Margin="0,14,0,0">
                    <Button x:Name="HubHistoryButton" Style="{StaticResource HubButton}" Margin="0,0,7,12" Click="HubHistory_Click">
                        <StackPanel>
                            <TextBlock Text="历史记录" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="最近 200 条完成 / 中断记录" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HubTaskStatsButton" Style="{StaticResource HubButton}" Margin="7,0,0,12" Click="HubTaskStats_Click">
                        <StackPanel>
                            <TextBlock Text="任务累计" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="关联任务的自律成绩" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Button x:Name="ShareCardButton" Style="{StaticResource HubButton}" Margin="0,2,0,0" Click="ShareCard_Click">
                    <StackPanel>
                        <TextBlock Text="生成战绩分享卡" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="导出今日战绩 PNG，可直接发到聊天 / 动态" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 历史记录子界面 -->
            <StackPanel x:Name="HistoryPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回自律统计" HorizontalAlignment="Left" Click="BackToStatsHub_Click" Margin="0,0,0,10" />
                <TextBlock Text="历史记录" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="最近 200 条记录" FontWeight="SemiBold" />
                        <ListBox x:Name="RecordsList" Height="420" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="刷新" Click="RefreshButton_Click" />
                            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 任务累计子界面 -->
            <StackPanel x:Name="TaskStatsPagePanel" Visibility="Collapsed">
                <Button Content="&#x2190; 返回自律统计" HorizontalAlignment="Left" Click="BackToStatsHub_Click" Margin="0,0,0,10" />
                <TextBlock Text="任务累计" Style="{StaticResource H1}" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="关联任务的自律成绩" FontWeight="SemiBold" />
                        <ListBox x:Name="TaskStatsList" Height="360" Margin="0,10,0,0" />
                        <TextBlock x:Name="TaskStatsHint" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>