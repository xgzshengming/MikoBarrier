<Window x:Class="MikoBarrier.Views.FullScreenOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikoBarrier 自律中" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" WindowState="Maximized"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.UI}">

    <Grid>
        <!-- 全屏背景层：只负责显示，TestHit 由上层内容接管 -->
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed" />
        <Border x:Name="BackgroundScrim" Background="#33000000" Visibility="Collapsed"
                IsHitTestVisible="False" />

        <!-- 中间内容卡片：可收起，收起后只保留顶部迷你计时条，背景图完整可见 -->
        <Grid x:Name="ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="ContentPanel" Style="{StaticResource Card}"
                    CornerRadius="24" Padding="42,34" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="MikoBarrier" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PhaseText" FontSize="15" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" Text="自律中" />
                    <TextBlock x:Name="CountdownText" Text="25:00" Width="460" FontSize="128" FontWeight="Bold"
                               FontFamily="Segoe UI" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <ProgressBar x:Name="Progress" Width="460" Height="10" Margin="0,10,0,0"
                                 Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="PlanText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock x:Name="GuardText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />

                    <Border Visibility="Collapsed" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,26,0,0" MaxWidth="720">
                        <StackPanel>
                            <TextBlock Text="启动台" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,6,0,0"
                                       Text="点下面的快捷方式 / 文件夹：遮罩会暂时收起 2 分钟，然后自动回来。黑名单里的程序依旧会被拦截。" />
                            <WrapPanel x:Name="LauncherPanel" HorizontalAlignment="Center" Margin="0,12,0,0" MaxWidth="680" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="浏览程序" Click="BrowseProgram_Click" />
                                <Button Content="浏览文件夹" Click="BrowseFolder_Click" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="AbortButton" Content="提前结束（需密码）" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Center" Margin="0,32,0,0" Padding="24,12" Click="Abort_Click" />
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16,0,0"
                               Text="自律结束后会自动关闭；需要提前结束请点上面的按钮。" />
                </StackPanel>
            </Border>
            <Button x:Name="CollapseCardButton" Content="收起" Padding="10,4"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0"
                    Click="CollapseCardButton_Click" />
        </Grid>

        <!-- 收起状态：顶部迷你计时条 + 展开 / 提前结束 -->
        <Border x:Name="CompactBar" Visibility="Collapsed"
                Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="18" Padding="14,8"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CompactCountdownText" Text="25:00" FontSize="26" FontWeight="Bold"
                           FontFamily="Segoe UI" VerticalAlignment="Center" />
                <TextBlock x:Name="CompactPhaseText" Style="{StaticResource Muted}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
                <Button x:Name="ExpandCardButton" Content="展开" Margin="16,0,0,0" Padding="12,5"
                        Click="ExpandCardButton_Click" />
                <Button x:Name="CompactAbortButton" Content="提前结束" Style="{StaticResource DangerButton}"
                        Margin="8,0,0,0" Padding="14,6" Click="Abort_Click" />
            </StackPanel>
        </Border>

        <!-- 全屏背景：自律进行中随时可换 -->
        <Border x:Name="AmbiencePanel" Visibility="Collapsed" Width="340"
                Style="{StaticResource Card}" Padding="18"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,72">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="全屏背景" FontWeight="SemiBold" FontSize="15" DockPanel.Dock="Left" />
                    <Button x:Name="AmbienceCloseButton" Content="&#x2715;" DockPanel.Dock="Right" Padding="8,2"
                            Margin="0" Click="AmbienceClose_Click" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="背景图只在全屏计时期间生效，自律进行中可随时切换。" />

                <TextBlock Text="背景图" FontWeight="SemiBold" Margin="0,14,0,6" />
                <ComboBox x:Name="BackgroundBox" MaxDropDownHeight="320" SelectionChanged="BackgroundBox_SelectionChanged" />
                <Border Height="150" Margin="0,8,0,0" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="BackgroundPreview" Stretch="UniformToFill" />
                        <TextBlock x:Name="BackgroundNoneText" Text="无背景" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Button x:Name="AmbienceButton" Content="背景" Padding="18,9"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Click="AmbienceButton_Click" />

        <!-- 巫女模式解锁线索：角落的裂缝。很淡、无按钮边框；未解锁时连点 3 次，之后永久隐藏。 -->
        <Button x:Name="MikoCrackButton" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24,0,0,24" Padding="0" Background="Transparent" BorderThickness="0"
                Focusable="False" IsTabStop="False" Cursor="Hand" Opacity="0.28" Panel.ZIndex="3"
                MinWidth="0" MinHeight="0"
                Click="MikoCrackButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ControlTemplate>
            </Button.Template>
            <Viewbox Width="42" Height="42">
                <Canvas Width="64" Height="64">
                    <Path Data="M 41,2 L 33,18 L 44,26 L 30,43 L 37,62"
                          Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path Data="M 33,18 L 22,23 L 14,17 M 44,26 L 54,22 M 30,43 L 20,48 M 37,62 L 45,60"
                          Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.25"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <Path Data="M 33,18 L 36,10 M 44,26 L 49,31"
                          Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</Window>